<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#B6BAC0</Color>

    <Color x:Key="TextEntryHighlightedBackgroundColor">#323539</Color>

    <Color x:Key="PrimaryButtonColor">#9BF00B</Color>
    <Color x:Key="PrimaryButtonHoverColor">#B5FF3D</Color>
    <Color x:Key="PrimaryButtonDisabledColor">#566A36</Color>
    <Color x:Key="PrimaryButtonClickedColor">#7CC000</Color>
    
    <Color x:Key="SecondaryButtonColor">#282C31</Color>
    <Color x:Key="SecondaryButtonHoverColor">#33383F</Color>
    <Color x:Key="SecondaryButtonDisabledColor">#2B2F34</Color>
    <Color x:Key="SecondaryButtonClickedColor">#41464D</Color>

    <Color x:Key="ComboBoxBorderHighlightColor">#8B9097</Color>
    <Color x:Key="HighlightedComboBoxItemColor">#233B17</Color>
    <Color x:Key="DropShadowComboBoxItemColor">#000000</Color>

    <Color x:Key="ApplicationControlsColor">#33383F</Color>
    <Color x:Key="ApplicationControlsSelectColor">#41464D</Color>

    <Color x:Key="ErrorRed">#FF889B</Color>
    <Color x:Key="ErrorRedTransluscent">#1AFF889B</Color>

    <Color x:Key="LightPurplishBlue">#9BF00B</Color>

    <Color x:Key="BorderColor">#41464D</Color>
    <Color x:Key="ErrorScreenBackgroundColor">#17191C</Color>
    <Color x:Key="BackgroundColor">#17191C</Color>

    <Color x:Key="ProgressBarForegroundColor">#9BF00B</Color>
    <Color x:Key="ProgressBarBackgroundColor">#33383F</Color>

    <!-- Semantic design tokens -->
    <Color x:Key="CanvasColor">#17191C</Color>
    <Color x:Key="LayerColor">#202327</Color>
    <Color x:Key="CardColor">#202327</Color>
    <Color x:Key="CardHoverColor">#282C31</Color>
    <Color x:Key="ControlFillColor">#282C31</Color>
    <Color x:Key="ControlFillHoverColor">#33383F</Color>
    <Color x:Key="ControlFillPressedColor">#41464D</Color>
    <Color x:Key="ControlFillDisabledColor">#2B2F34</Color>
    <Color x:Key="ControlStrokeColor">#5A6068</Color>
    <Color x:Key="ControlStrokeFocusColor">#60CDFF</Color>
    <Color x:Key="DisabledTextColor">#777C83</Color>
    <Color x:Key="AccentTextColor">#102000</Color>
    <Color x:Key="DividerColor">#363B42</Color>
    <Color x:Key="SuccessColor">#9BF00B</Color>
    <Color x:Key="SuccessBackgroundColor">#233B17</Color>
    <Color x:Key="WarningColor">#FCE100</Color>
    <Color x:Key="WarningBackgroundColor">#3F3812</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

    <SolidColorBrush x:Key="TextEntryHighlightedBackgroundBrush" Color="{StaticResource TextEntryHighlightedBackgroundColor}" />

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="{StaticResource PrimaryButtonColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource PrimaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonDisabledBrush" Color="{StaticResource PrimaryButtonDisabledColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonClickedBrush" Color="{StaticResource PrimaryButtonClickedColor}"/>
 
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{StaticResource SecondaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonDisabledBrush" Color="{StaticResource SecondaryButtonDisabledColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonClickedBrush" Color="{StaticResource SecondaryButtonClickedColor}"/>

    <SolidColorBrush x:Key="ComboBoxBorderHighlightBrush" Color="{StaticResource ComboBoxBorderHighlightColor}"/>
    <SolidColorBrush x:Key="HighlightedComboBoxItemBrush" Color="{StaticResource HighlightedComboBoxItemColor}"/>

    <SolidColorBrush x:Key="ApplicationControlsBrush" Color="{StaticResource ApplicationControlsColor}"/>
    <SolidColorBrush x:Key="ApplicationControlsSelectBrush" Color="{StaticResource ApplicationControlsSelectColor}"/>

    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}"/>
    <SolidColorBrush x:Key="ErrorRedTransluscentBrush" Color="{StaticResource ErrorRedTransluscent}"/>

    <SolidColorBrush x:Key="LightPurplishBlueBrush" Color="{StaticResource LightPurplishBlue}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ErrorScreenBackgroundBrush" Color="{StaticResource ErrorScreenBackgroundColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource BackgroundColor}"/>

    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{StaticResource ProgressBarForegroundColor}"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="{StaticResource ProgressBarBackgroundColor}"/>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}"/>
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}"/>
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="{StaticResource ControlFillDisabledColor}"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}"/>
    <SolidColorBrush x:Key="ControlStrokeFocusBrush" Color="{StaticResource ControlStrokeFocusColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>
    
</ResourceDictionary>