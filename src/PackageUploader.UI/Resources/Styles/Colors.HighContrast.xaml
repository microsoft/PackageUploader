<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="PrimaryTextColor">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="SecondaryTextColor">{x:Static SystemColors.WindowTextColor}</Color>

    <Color x:Key="TextEntryHighlightedBackgroundColor">{x:Static SystemColors.HighlightColor}</Color>

    <Color x:Key="PrimaryButtonColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="PrimaryButtonHoverColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="PrimaryButtonDisabledColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="PrimaryButtonClickedColor">{x:Static SystemColors.HighlightColor}</Color>

    <Color x:Key="SecondaryButtonColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="SecondaryButtonHoverColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="SecondaryButtonDisabledColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="SecondaryButtonClickedColor">{x:Static SystemColors.HighlightColor}</Color>

    <Color x:Key="ComboBoxBorderHighlightColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="HighlightedComboBoxItemColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="DropShadowComboBoxItemColor">{x:Static SystemColors.GrayTextColor}</Color>

    <Color x:Key="ApplicationControlsColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="ApplicationControlsSelectColor">{x:Static SystemColors.WindowTextColor}</Color>

    <Color x:Key="ErrorRed">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="ErrorRedTransluscent">{x:Static SystemColors.WindowColor}</Color>

    <Color x:Key="LightPurplishBlue">{x:Static SystemColors.HighlightColor}</Color>

    <Color x:Key="BorderColor">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="ErrorScreenBackgroundColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="BackgroundColor">{x:Static SystemColors.WindowColor}</Color>

    <Color x:Key="ProgressBarForegroundColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="ProgressBarBackgroundColor">{x:Static SystemColors.WindowColor}</Color>

    <!-- Semantic design tokens -->
    <Color x:Key="CanvasColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="LayerColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="CardColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="CardHoverColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="ControlFillColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="ControlFillHoverColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="ControlFillPressedColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="ControlFillDisabledColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="ControlStrokeColor">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="ControlStrokeFocusColor">{x:Static SystemColors.HighlightColor}</Color>
    <Color x:Key="DisabledTextColor">{x:Static SystemColors.GrayTextColor}</Color>
    <Color x:Key="AccentTextColor">{x:Static SystemColors.HighlightTextColor}</Color>
    <Color x:Key="DividerColor">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="SuccessColor">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="SuccessBackgroundColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="WarningColor">{x:Static SystemColors.WindowTextColor}</Color>
    <Color x:Key="WarningBackgroundColor">{x:Static SystemColors.WindowColor}</Color>
    <Color x:Key="ShadowColor">{x:Static SystemColors.WindowTextColor}</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

    <SolidColorBrush x:Key="TextEntryHighlightedBackgroundBrush" Color="{StaticResource TextEntryHighlightedBackgroundColor}" />

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="{StaticResource PrimaryButtonColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource PrimaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonDisabledBrush" Color="{StaticResource PrimaryButtonDisabledColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonClickedBrush" Color="{StaticResource PrimaryButtonClickedColor}"/>

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{StaticResource SecondaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonDisabledBrush" Color="{StaticResource SecondaryButtonDisabledColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonClickedBrush" Color="{StaticResource SecondaryButtonClickedColor}"/>

    <SolidColorBrush x:Key="ComboBoxBorderHighlightBrush" Color="{StaticResource ComboBoxBorderHighlightColor}"/>
    <SolidColorBrush x:Key="HighlightedComboBoxItemBrush" Color="{StaticResource HighlightedComboBoxItemColor}"/>

    <SolidColorBrush x:Key="ApplicationControlsBrush" Color="{StaticResource ApplicationControlsColor}"/>
    <SolidColorBrush x:Key="ApplicationControlsSelectBrush" Color="{StaticResource ApplicationControlsSelectColor}"/>

    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}"/>
    <SolidColorBrush x:Key="ErrorRedTransluscentBrush" Color="{StaticResource ErrorRedTransluscent}"/>

    <SolidColorBrush x:Key="LightPurplishBlueBrush" Color="{StaticResource LightPurplishBlue}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ErrorScreenBackgroundBrush" Color="{StaticResource ErrorScreenBackgroundColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource BackgroundColor}"/>

    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{StaticResource ProgressBarForegroundColor}"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="{StaticResource ProgressBarBackgroundColor}"/>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}"/>
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}"/>
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="{StaticResource ControlFillDisabledColor}"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}"/>
    <SolidColorBrush x:Key="ControlStrokeFocusBrush" Color="{StaticResource ControlStrokeFocusColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>

</ResourceDictionary>