<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font Sizes -->
    <sys:Double x:Key="HeadlineFontSize">24</sys:Double>
    <sys:Double x:Key="SubHeadlineFontSize">16</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="TinyFontSize">11</sys:Double>

    <!-- Control Sizing -->
    <sys:Double x:Key="ControlMinHeight">34</sys:Double>
    <sys:Double x:Key="InputMinHeight">36</sys:Double>

    <!-- Padding -->
    <Thickness x:Key="ButtonPadding">12,6,12,6</Thickness>
    <Thickness x:Key="PagePadding">16,12,16,12</Thickness>
    <Thickness x:Key="WorkflowPagePadding">16,12,16,8</Thickness>
    <Thickness x:Key="MainPagePadding">16,0,16,0</Thickness>

    <!-- Status/Progress Screens -->
    <sys:Double x:Key="StatusImageSize">50</sys:Double>
    <Thickness x:Key="StatusImageMargin">0,10,0,8</Thickness>
    <Thickness x:Key="ProgressImageMargin">0,10,0,4</Thickness>
    <sys:Double x:Key="ProgressBarMaxWidth">400</sys:Double>
    <Thickness x:Key="ProgressHeadingMargin">0,0,0,6</Thickness>
    <Thickness x:Key="ProgressSectionMargin">0,0,0,12</Thickness>

    <!-- Section Spacing -->
    <Thickness x:Key="HeadlineMargin">0,25,0,6</Thickness>
    <Thickness x:Key="SubtitleMargin">0,2,0,6</Thickness>
    <Thickness x:Key="SectionCardPadding">14,14,14,14</Thickness>
    <Thickness x:Key="CardBottomMargin">0,0,0,15</Thickness>
    <sys:Double x:Key="PreviewFontSize">10</sys:Double>
    <sys:Double x:Key="PreviewImageSize">40</sys:Double>
    <Thickness x:Key="PreviewPadding">3,3,3,3</Thickness>
    <Thickness x:Key="PreviewItemMargin">0,0,0,2</Thickness>

</ResourceDictionary>
