<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page structure -->
    <Style x:Key="PageTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource Headline}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="MaxWidth" Value="900" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- Reusable surfaces -->
    <Style x:Key="AccountBannerStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardContainerStyle}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="ActionCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource InteractiveCardContainerStyle}">
        <Setter Property="MinHeight" Value="230" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CompactActionCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardContainerStyle}">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="IconTileStyle"
           TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CompactIconTileStyle"
           TargetType="Border"
           BasedOn="{StaticResource IconTileStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="BadgeStyle"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- Card content -->
    <Style x:Key="CardTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SubHeadline}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style x:Key="CardBodyTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Margin" Value="0,8,0,16" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="BadgeTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource SemiboldFontWeight}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="CardActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="128" />
    </Style>
</ResourceDictionary>
