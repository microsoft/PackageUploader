<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PackageUploader.UI"
        xmlns:view="clr-namespace:PackageUploader.UI.View"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:strings="clr-namespace:PackageUploader.UI.Resources.Strings"
        x:Class="PackageUploader.UI.MainWindow"
        mc:Ignorable="d"
        Title="{x:Static strings:MainPage.ApplicationName}"
        Height="800"
        Width="1200"
        MinHeight="400"
        MinWidth="600"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Icon="Resources/AppIcon/WindowsIcon.png">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            ResizeBorderThickness="5"
            GlassFrameThickness="0"
            CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource DropShadowComboBoxItemColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.40"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource LayerBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon and Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="12"
                            Background="{DynamicResource PrimaryButtonBrush}">
                        <TextBlock Text="X"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Static strings:MainPage.ApplicationName}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <Border x:Name="EnvironmentBadge"
                            Style="{StaticResource TopNavigationEnvironmentStyle}">
                        <TextBlock Text="{x:Static strings:MainPage.DeveloperToolLabel}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Temporary theme toggle for redesign testing. Production behavior remains system-driven. -->
                    <Button x:Name="ThemeToggleButton"
                            Width="38" Height="48"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="ThemeToggleButton_Click"
                            Style="{StaticResource WindowControlButtonStyle}"
                            AutomationProperties.HelpText="Temporarily toggle light and dark theme"
                            ToolTip="Switch to light mode">
                        <Path x:Name="ThemeToggleIcon"
                              Data="M8,2 A6,6 0 1 0 14,8 A5,5 0 0 1 8,2"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>
                    <!-- Compact mode toggle -->
                    <Button x:Name="CompactModeButton"
                            Width="38" Height="48"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CompactModeButton_Click"
                            Style="{StaticResource WindowControlButtonStyle}"
                            AutomationProperties.HelpText="{x:Static strings:MainPage.CompactModeHelpText}"
                            ToolTip="{x:Static strings:MainPage.CompactModeTooltipCompact}">
                        <Path x:Name="CompactModeIcon"
                              Data="M3,5 H13 M3,8 H13 M3,11 H13"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>
                    <!-- Send feedback button -->
                    <Grid x:Name="HelpButtonGrid">
                        <Button x:Name="HelpButton"
                                Width="38" Height="48"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="HelpButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"
                                AutomationProperties.HelpText="{x:Static strings:MainPage.HelpAndFeedback}"
                                ToolTip="{x:Static strings:MainPage.HelpAndFeedback}">
                            <TextBlock Text="?"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="HelpMenuPopup"
                               PlacementTarget="{Binding ElementName=HelpButton}"
                               Placement="Bottom"
                               HorizontalOffset="-142"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="180"
                                    Padding="6"
                                    Background="{DynamicResource LayerBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                                      BlurRadius="14"
                                                      ShadowDepth="3"
                                                      Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button Click="DocumentationButton_Click"
                                            Style="{StaticResource HelpMenuItemStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M3,3 H10 C12,3 13,4 13,6 V18 C13,16 12,15 10,15 H3 Z M21,3 H14 C12,3 11,4 11,6 V18 C11,16 12,15 14,15 H21 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4"
                                                  Width="16"
                                                  Height="16"
                                                  Stretch="Uniform"
                                                  Margin="0,0,10,0"/>
                                            <TextBlock Text="{x:Static strings:MainPage.DocumentationMenuItem}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Height="1"
                                            Background="{DynamicResource DividerBrush}"
                                            Margin="8,4"/>
                                    <Button Click="GitHubIssuesButton_Click"
                                            Style="{StaticResource HelpMenuItemStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M4,4 H20 V16 H12 L7,21 V16 H4 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4"
                                                  Width="16"
                                                  Height="16"
                                                  Stretch="Uniform"
                                                  Margin="0,0,10,0"/>
                                            <TextBlock Text="{x:Static strings:MainPage.ReportIssueMenuItem}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button x:Name="UserSignoutButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="UserSignoutButton_Click"
                            Style="{StaticResource UserSignoutButtonStyle}"
                            Visibility="Collapsed"
                            AutomationProperties.HelpText="{x:Static strings:MainPage.SignOutUser}">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource PrimaryButtonBrush}">
                            <TextBlock x:Name="UserInitialsText"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <Button x:Name="MinimizeButton"
                            Width="46" Height="48"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource WindowControlButtonStyle}"
                            AutomationProperties.HelpText="Minimize the window"
                            ToolTip="{x:Static strings:MainPage.MinimizeWindow}">
                        <Path Data="M0,6 H10"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Stretch="None"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Width="46" Height="48"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource WindowControlButtonStyle}"
                            AutomationProperties.HelpText="Maximize the window"
                            ToolTip="{x:Static strings:MainPage.MaximizeWindow}">
                        <Path x:Name="MaximizeIcon"
                              Data="M0,0 H10 V10 H0 V0"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Stretch="None"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Width="46" Height="48"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            AutomationProperties.HelpText="Close the application"
                            ToolTip="{x:Static strings:MainPage.CloseWindow}">
                        <Path Data="M0,0 L10,10 M0,10 L10,0"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Stretch="None"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <ContentControl Grid.Row="1" x:Name="ContentArea"/>

            <!-- Version Information -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderThickness="0">
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           Margin="10,4"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>