<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:PackageUploader.UI.ViewModel"
             xmlns:converters="clr-namespace:PackageUploader.UI.Converters"
             xmlns:strings="clr-namespace:PackageUploader.UI.Resources.Strings"
             x:Class="PackageUploader.UI.View.Msixvc2UploadingView"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodel:Msixvc2UploadingViewModel}"
             Background="{DynamicResource CanvasBrush}">
    <UserControl.Resources>
        <converters:Msixvc2UploadStageToVisibilityConverter x:Key="UploadStageConverter" />
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:5"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="{DynamicResource PagePadding}"
              MaxWidth="1000"
              HorizontalAlignment="Stretch">
            <StackPanel Margin="0,24,0,0">
                <Border Style="{DynamicResource StatusTileStyle}">
                    <Path Data="M 4,12 L 20,12 M 14,6 L 20,12 L 14,18"
                          Stroke="{DynamicResource SuccessBrush}"
                          StrokeThickness="2.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="32"
                          Height="32"
                          Stretch="Uniform" />
                </Border>
                <TextBlock Text="{x:Static strings:Msixvc2Uploading.TitleText}"
                           d:Text="Uploading package to Partner Center"
                           Style="{StaticResource PageTitleTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static strings:Msixvc2Uploading.SubtitleText}"
                           d:Text="Keep this window open while Xbox Game Package Manager prepares, validates, and uploads your game."
                           Style="{StaticResource PageSubtitleTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,24"
                           MaxWidth="680" />

                <Border Style="{DynamicResource ProgressPanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static strings:Msixvc2Uploading.UploadingText}"
                                       d:Text="Uploading"
                                       Style="{StaticResource SubHeadline}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <TextBlock Text="{Binding UploadPercentage, Mode=OneWay}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="{DynamicResource BoldFontWeight}"
                                           FontSize="{DynamicResource SubHeadlineFontSize}" />
                                <TextBlock Text="{x:Static strings:Msixvc2Uploading.PercentCompleteText}"
                                           d:Text="% complete"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="3,0,0,1" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding UploadPercentage}"
                                     Height="8"
                                     Margin="0,14,0,0"
                                     HorizontalAlignment="Stretch" />
                        <Grid MinHeight="18"
                              Margin="0,10,0,18">
                            <TextBlock Text="{Binding UploadStats}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowUploadStats, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <Border Style="{DynamicResource ProgressStageRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Preparing}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Uploading-Done}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:Msixvc2Uploading.PreparingText}"
                                           d:Text="Preparing package..."
                                           Style="{DynamicResource ProgressStageTitleStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{DynamicResource ProgressStageRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0"
                                                Template="{StaticResource ClockFaceWaitingTemplate}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Preparing}" />
                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Uploading}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Validating-Done}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:Msixvc2Uploading.UploadingContentText}"
                                           d:Text="Uploading content..."
                                           Style="{DynamicResource ProgressStageTitleStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{DynamicResource ProgressStageRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0"
                                                Template="{StaticResource ClockFaceWaitingTemplate}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Preparing-Uploading}" />
                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Validating}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Finalizing-Done}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:Msixvc2Uploading.ValidatingText}"
                                           d:Text="Validating package..."
                                           Style="{DynamicResource ProgressStageTitleStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{DynamicResource ProgressStageRowStyle}"
                                Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0"
                                                Template="{StaticResource ClockFaceWaitingTemplate}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Preparing-Validating}" />
                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Finalizing}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding UploadStage, Converter={StaticResource UploadStageConverter}, ConverterParameter=Done}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:Msixvc2Uploading.FinalizingText}"
                                           d:Text="Finalizing upload..."
                                           Style="{DynamicResource ProgressStageTitleStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource WorkflowActionBarStyle}"
                        MaxWidth="760"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{x:Static strings:Msixvc2Uploading.ViewLogsButtonText}"
                                d:Content="View logs"
                                Command="{Binding ViewLogsCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="96" />
                        <Button Grid.Column="1"
                                Content="{x:Static strings:Msixvc2Uploading.CancelUploadButtonText}"
                                d:Content="Cancel upload"
                                Command="{Binding CancelUploadCommand}"
                                MinWidth="125" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
