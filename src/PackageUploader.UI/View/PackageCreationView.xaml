<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:PackageUploader.UI.ViewModel"
             xmlns:strings="clr-namespace:PackageUploader.UI.Resources.Strings"
             x:Class="PackageUploader.UI.View.PackageCreationView"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodel:PackageCreationViewModel}"
             Background="{DynamicResource CanvasBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{DynamicResource PagePadding}"
              MaxWidth="1320"
              HorizontalAlignment="Center">
            <StackPanel>
                <!-- Page heading -->
                <Grid Margin="0,6,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding CancelButtonCommand}"
                            Style="{DynamicResource WorkflowBackButtonStyle}"
                            AutomationProperties.HelpText="Back to home">
                        <Path Data="M16,8 L4,8 M4,8 L8,4 M4,8 L8,12"
                              Stroke="{DynamicResource PrimaryTextBrush}"
                              StrokeThickness="1.5"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static strings:PackageCreation.TitleString}"
                                   d:Text="Make a game package">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource PageTitleTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                            <Setter Property="FontSize" Value="20" />
                                            <Setter Property="LineHeight" Value="26" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{x:Static strings:PackageCreation.SubTitleText}"
                                   d:Text="Locate your game's build to create a package. The Xbox Game Package Manager retains these paths for easier access in the future."
                                   Style="{StaticResource PageSubtitleTextStyle}"
                                   Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Grid>

                <DockPanel LastChildFill="True">
                    <!-- Preview moves below the steps in compact mode. -->
                    <Border DockPanel.Dock="Right">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
                                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Width" Value="360" />
                                <Setter Property="Margin" Value="24,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Margin" Value="0,8,0,16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewTitleText}"
                                       d:Text="Preview"
                                       Style="{DynamicResource WorkflowPreviewTitleStyle}" />

                            <!-- Empty preview -->
                            <StackPanel HorizontalAlignment="Center"
                                        Margin="8,24,8,28"
                                        Visibility="{Binding HasValidGameConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Path Data="M4,5 H20 V19 H4 Z M8,9 H16 M8,13 H14"
                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.5"
                                          Width="30"
                                          Height="30"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewEmptyText}"
                                           d:Text="Your package preview will appear after a valid MicrosoftGame.config file is found."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextAlignment="Center"
                                           MaxWidth="280"
                                           Margin="0,14,0,0" />
                            </StackPanel>

                            <!-- Populated preview -->
                            <StackPanel Visibility="{Binding HasValidGameConfig, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding PackagePreviewImage}"
                                       Height="{DynamicResource PreviewImageSize}"
                                       Width="{DynamicResource PreviewImageSize}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,18" />

                                <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewPackageIdText}"
                                           d:Text="Package Identity Name"
                                           Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                <TextBlock Text="{Binding PackageId}"
                                           Style="{DynamicResource WorkflowMetadataValueStyle}"
                                           Margin="0,0,0,18" />

                                <Grid Visibility="{Binding StoreIdNotAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewStoreIdText}"
                                                   d:Text="StoreId"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding BigId}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewSizeEstimate}"
                                                   d:Text="Size estimate"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding PackageSize}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewFamilyText}"
                                                   d:Text="Family"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding PackageType}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12"
                                        Visibility="{Binding StoreIdNotAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static strings:PackageCreation.PackagePreviewNoPreviewAvailable}"
                                               d:Text="Full preview isn't available because the provided MicrosoftGame.config file doesn't have a StoreId."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Form steps -->
                    <StackPanel>
                        <!-- Step 1 -->
                        <Border Style="{DynamicResource WorkflowStepCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{DynamicResource WorkflowStepIndicatorStyle}">
                                    <TextBlock Text="1"
                                               Style="{DynamicResource WorkflowStepNumberStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static strings:PackageCreation.BuildLocationTitle}"
                                               d:Text="Build location"
                                               Style="{DynamicResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="{x:Static strings:PackageCreation.BuildLocationText}"
                                               d:Text="Locate your game files to package. Add a layout file under Additional Details."
                                               Style="{DynamicResource WorkflowStepDescriptionStyle}"
                                               Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Static strings:PackageCreation.GamePathTitleText}"
                                                   d:Text="Game path"
                                                   Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static strings:PackageCreation.RequiredText}"
                                                   d:Text="Required"
                                                   Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="GamePathTextBox"
                                                     AutomationProperties.HelpText="Path to game files"
                                                     Text="{Binding GameDataPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="{x:Static strings:PackageCreation.GamePathBoxDefaultText}"
                                                     Style="{DynamicResource WorkflowPathTextBoxStyle}" />
                                            <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding GameConfigLoadError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Content="{x:Static strings:PackageCreation.BrowseText}"
                                                d:Content="Browse"
                                                Command="{Binding BrowseGameDataPathCommand}"
                                                Style="{DynamicResource WorkflowBrowseButtonStyle}"
                                                AutomationProperties.HelpText="Browse to game files" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding GameConfigLoadError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding GameConfigLoadError}"
                                                   Style="{DynamicResource WorkflowValidationTextStyle}" />
                                    </StackPanel>

                                    <Expander Style="{StaticResource CustomExpanderStyle}"
                                              Margin="0,18,0,0"
                                              IsExpanded="{Binding IsAdditionalDetailsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <TextBlock Text="{x:Static strings:PackageCreation.AdditionalDetailsTitle}"
                                                       d:Text="Additional details"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="{DynamicResource SemiboldFontWeight}" />
                                        </Expander.Header>

                                        <StackPanel Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static strings:PackageCreation.LayoutFileMapTitle}"
                                                           d:Text="Layout file/content map"
                                                           Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Static strings:PackageCreation.OptionalText}"
                                                           d:Text="Optional"
                                                           Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <TextBox x:Name="MappingDataTextBox"
                                                             AutomationProperties.HelpText="Path to layout file"
                                                             Text="{Binding MappingDataXmlPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Tag="{x:Static strings:PackageCreation.ContentMapPathBoxDefaultText}"
                                                             Style="{DynamicResource WorkflowPathTextBoxStyle}" />
                                                    <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding LayoutParseError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                </Grid>
                                                <Button Grid.Column="1"
                                                        Content="{x:Static strings:PackageCreation.BrowseText}"
                                                        d:Content="Browse"
                                                        Command="{Binding BrowseMappingDataXmlPathCommand}"
                                                        Style="{DynamicResource WorkflowBrowseButtonStyle}"
                                                        AutomationProperties.HelpText="Browse to layout file" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,8,0,14"
                                                        Visibility="{Binding LayoutParseError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding LayoutParseError}"
                                                           Style="{DynamicResource WorkflowValidationTextStyle}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding SupportsCustomSubValPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Static strings:PackageCreation.ValidatorPathTitleText}"
                                                               d:Text="Folder path for SubmissionValidator.dll"
                                                               Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Static strings:PackageCreation.OptionalText}"
                                                               d:Text="Optional"
                                                               Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0">
                                                        <TextBox x:Name="SubValPathTextBox"
                                                                 AutomationProperties.HelpText="Submission Validator folder path"
                                                                 Text="{Binding SubValPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Tag="{x:Static strings:PackageCreation.ValidatorPathBoxDefaultText}"
                                                                 Style="{DynamicResource WorkflowPathTextBoxStyle}" />
                                                        <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding SubValDllError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                    </Grid>
                                                    <Button Grid.Column="1"
                                                            Content="{x:Static strings:PackageCreation.BrowseText}"
                                                            d:Content="Browse"
                                                            Command="{Binding BrowseSubValPathCommand}"
                                                            Style="{DynamicResource WorkflowBrowseButtonStyle}"
                                                            AutomationProperties.HelpText="Browse to Submission Validator folder path" />
                                                </Grid>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,8,0,0"
                                                            Visibility="{Binding SubValDllError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                    <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                                           Width="16"
                                                           Height="16"
                                                           VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding SubValDllError}"
                                                               Style="{DynamicResource WorkflowValidationTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border Style="{DynamicResource WorkflowStepCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{DynamicResource WorkflowStepIndicatorStyle}">
                                    <TextBlock Text="2"
                                               Style="{DynamicResource WorkflowStepNumberStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static strings:PackageCreation.PackageOutputTitleText}"
                                               d:Text="Package output location"
                                               Style="{DynamicResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="{x:Static strings:PackageCreation.PackageOutputBoxText}"
                                               d:Text="Select or enter the package output location."
                                               Style="{DynamicResource WorkflowStepDescriptionStyle}"
                                               Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Static strings:PackageCreation.PackagePathTitleText}"
                                                   d:Text="Package path"
                                                   Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static strings:PackageCreation.OptionalText}"
                                                   d:Text="Optional"
                                                   Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="PackagePathTextBox"
                                                     AutomationProperties.HelpText="Output folder"
                                                     Text="{Binding PackageFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="{x:Static strings:PackageCreation.PackageOutputBoxText}"
                                                     Style="{DynamicResource WorkflowPathTextBoxStyle}" />
                                            <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding OutputDirectoryError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Content="{x:Static strings:PackageCreation.BrowseText}"
                                                d:Content="Browse"
                                                Command="{Binding BrowsePackageOutputPathCommand}"
                                                Style="{DynamicResource WorkflowBrowseButtonStyle}"
                                                AutomationProperties.HelpText="Browse to output folder" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding OutputDirectoryError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding OutputDirectoryError}"
                                                   Style="{DynamicResource WorkflowValidationTextStyle}" />
                                    </StackPanel>

                                    <CheckBox Content="{x:Static strings:PackageCreation.UseMsixvc2Text}"
                                              d:Content="Package as MSIXVC2 (.msixvc)"
                                              IsChecked="{Binding UseMsixvc2}"
                                              Visibility="{Binding IsMsixvc2Available, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              HorizontalAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Margin="0,14,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Actions -->
                <Border Style="{DynamicResource WorkflowActionBarStyle}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{x:Static strings:PackageCreation.CancelButtonText}"
                                d:Content="Cancel"
                                Command="{Binding CancelButtonCommand}"
                                MinWidth="90"
                                Margin="0,0,10,0" />
                        <Button Content="{x:Static strings:PackageCreation.CreatePackageButtonText}"
                                d:Content="Make package"
                                Command="{Binding MakePackageCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="128" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
