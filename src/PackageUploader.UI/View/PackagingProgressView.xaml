<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:PackageUploader.UI.ViewModel"
             xmlns:converters="clr-namespace:PackageUploader.UI.Converters"
             xmlns:strings="clr-namespace:PackageUploader.UI.Resources.Strings"
             x:Class="PackageUploader.UI.View.PackagingProgressView"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodel:PackagingProgressViewModel}"
             Background="{DynamicResource CanvasBrush}">

    <UserControl.Resources>
        <converters:ProgressToVisibilityConverter x:Key="ProgressToVisibilityConverter" />
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:5"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="{DynamicResource PagePadding}"
              MaxWidth="1000"
              HorizontalAlignment="Stretch">
            <StackPanel Margin="0,24,0,0">
                <!-- Page status -->
                <Image Source="/Resources/Images/InProgress.png"
                       Height="{DynamicResource StatusImageSize}"
                       Width="{DynamicResource StatusImageSize}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18" />
                <TextBlock Text="{x:Static strings:PackagingProgress.PackagingProgressTitleText}"
                           d:Text="Getting your package ready..."
                           Style="{StaticResource PageTitleTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static strings:PackagingProgress.PackagingProgressSubtitleText}"
                           d:Text="Keep this window open while Xbox Game Package Manager validates and packages your game."
                           Style="{StaticResource PageSubtitleTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,24"
                           MaxWidth="680" />

                <!-- Progress workspace -->
                <Border Style="{DynamicResource ProgressPanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Static strings:PackagingProgress.PackingText}"
                                       d:Text="Packaging..."
                                       Style="{StaticResource SubHeadline}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       Visibility="{Binding IsMsixvc2, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static strings:PackagingProgress.PackingMsixvc2Text}"
                                       d:Text="Packaging using MSIXVC2..."
                                       Style="{StaticResource SubHeadline}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       Visibility="{Binding IsMsixvc2, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <TextBlock Text="{Binding PackingProgressPercentage, Mode=OneWay}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="{DynamicResource BoldFontWeight}"
                                           FontSize="{DynamicResource SubHeadlineFontSize}" />
                                <TextBlock Text="{x:Static strings:PackagingProgress.PercentComplete}"
                                           d:Text="% complete"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="3,0,0,1" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding PackingProgressPercentage}"
                                     Height="8"
                                     Margin="0,14,0,24"
                                     HorizontalAlignment="Stretch" />

                        <!-- Stage 1: validation -->
                        <Border Style="{DynamicResource ProgressStageRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=0-5}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=6-100}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:PackagingProgress.ValidatingFilesText}"
                                           d:Text="Validating files..."
                                           Style="{DynamicResource ProgressStageTitleStyle}" />
                            </Grid>
                        </Border>

                        <!-- Stage 2: packaging data -->
                        <Border Style="{DynamicResource ProgressStageRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="0"
                                                Template="{StaticResource ClockFaceWaitingTemplate}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=0-5}" />
                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=6-93}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=94-100}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:PackagingProgress.CopyingAndEncryptingText}"
                                           d:Text="Copying and encrypting data..."
                                           Style="{DynamicResource ProgressStageTitleStyle}"
                                           Visibility="{Binding IsMsixvc2, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:PackagingProgress.PackagingDataText}"
                                           d:Text="Packaging data..."
                                           Style="{DynamicResource ProgressStageTitleStyle}"
                                           Visibility="{Binding IsMsixvc2, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Stage 3: verification -->
                        <Border Style="{DynamicResource ProgressStageRowStyle}"
                                Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="0"
                                                Template="{StaticResource ClockFaceWaitingTemplate}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=0-94}" />
                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=95-99}">
                                    <Image Source="/Resources/AppIcon/Settings.png">
                                        <Image.RenderTransform>
                                            <RotateTransform CenterX="9" CenterY="9" />
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                                <Image Grid.Column="0"
                                       Source="/Resources/AppIcon/Accept.png"
                                       Width="18"
                                       Height="18"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding PackingProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}, ConverterParameter=100-100}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static strings:PackagingProgress.VerifyingPackageContentsText}"
                                           d:Text="Verifying package contents..."
                                           Style="{DynamicResource ProgressStageTitleStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{DynamicResource WorkflowActionBarStyle}"
                        MaxWidth="760"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{x:Static strings:PackagingProgress.ViewLogsButtonContentText}"
                                d:Content="View logs"
                                Command="{Binding ViewLogsCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="96" />
                        <Button Grid.Column="1"
                                Content="{x:Static strings:PackagingProgress.CancelPackagingButtonContentText}"
                                d:Content="Cancel packaging"
                                Command="{Binding CancelCreationCommand}"
                                MinWidth="141" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
