<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:PackageUploader.UI.ViewModel"
             xmlns:strings="clr-namespace:PackageUploader.UI.Resources.Strings"
             x:Class="PackageUploader.UI.View.Msixvc2UploadView"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodel:Msixvc2UploadViewModel}"
             Background="{DynamicResource CanvasBrush}">

    <UserControl.Resources>
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:5"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="{DynamicResource PagePadding}"
              MaxWidth="1320"
              HorizontalAlignment="Stretch">
            <StackPanel>
                <!-- Page heading -->
                <Grid Margin="0,6,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding CancelButtonCommand}"
                            Style="{DynamicResource WorkflowBackButtonStyle}"
                            AutomationProperties.HelpText="Back to home">
                        <Path Data="M16,8 L4,8 M4,8 L8,4 M4,8 L8,12"
                              Stroke="{DynamicResource PrimaryTextBrush}"
                              StrokeThickness="1.5"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static strings:Msixvc2Upload.TitleText}"
                                   d:Text="Upload Loose Files (PC only)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource PageTitleTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                            <Setter Property="FontSize" Value="20" />
                                            <Setter Property="LineHeight" Value="26" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{x:Static strings:Msixvc2Upload.SubtitleText}"
                                   d:Text="Point to your loose file directory for your PC game containing a MicrosoftGame.config and we will package and upload using the MSIXVC2 format."
                                   Style="{StaticResource PageSubtitleTextStyle}"
                                   Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Grid>

                <DockPanel LastChildFill="True">
                    <!-- Preview moves below the workflow in compact mode. -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
                                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Width" Value="380" />
                                <Setter Property="Margin" Value="24,0,0,0" />
                                <Setter Property="DockPanel.Dock" Value="Right" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Margin" Value="0,8,0,16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="{x:Static strings:Msixvc2Upload.UploadPreviewTitleText}"
                                       d:Text="Upload Preview"
                                       Style="{DynamicResource WorkflowPreviewTitleStyle}" />

                            <!-- Empty preview -->
                            <StackPanel HorizontalAlignment="Center"
                                        Margin="8,24,8,28"
                                        Visibility="{Binding ProductName, Converter={StaticResource StringNotEmptyToVisibilityConverter}, ConverterParameter=Invert}">
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Path Data="M4,5 H20 V19 H4 Z M8,9 H16 M8,13 H14 M12,16 V8 M9,11 L12,8 L15,11"
                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.5"
                                          Width="30"
                                          Height="30"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Static strings:Msixvc2Upload.UploadPreviewEmptyText}"
                                           d:Text="Package and destination details will appear after you select a valid loose-content folder."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextAlignment="Center"
                                           MaxWidth="300"
                                           Margin="0,14,0,0" />
                            </StackPanel>

                            <!-- Populated preview -->
                            <StackPanel Visibility="{Binding ProductName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <Border Style="{DynamicResource WorkflowPreviewHeroStyle}">
                                    <Image Source="{Binding PackagePreviewImage}"
                                           Height="{DynamicResource PreviewImageSize}"
                                           Width="{DynamicResource PreviewImageSize}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           Margin="18" />
                                </Border>

                                <TextBlock Text="{x:Static strings:Msixvc2Upload.ProductNameText}"
                                           d:Text="Product name"
                                           Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                <TextBlock Text="{Binding ProductName}"
                                           Style="{DynamicResource WorkflowMetadataValueStyle}"
                                           Margin="0,0,0,18" />

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{x:Static strings:Msixvc2Upload.DestinationTitleText}"
                                                   d:Text="Destination"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding BranchOrFlightDisplayName}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Static strings:Msixvc2Upload.MarketTitleText}"
                                                   d:Text="Market"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding MarketGroupName}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{x:Static strings:Msixvc2Upload.PackageIdentityNameTitleText}"
                                           d:Text="Package Identity name"
                                           Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                <TextBlock Text="{Binding PackageIdentityName}"
                                           Style="{DynamicResource WorkflowMetadataValueStyle}"
                                           Margin="0,0,0,18" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{x:Static strings:Msixvc2Upload.StoreIdTitleText}"
                                                   d:Text="Store ID"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding BigId}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{x:Static strings:Msixvc2Upload.FolderSizeTitleText}"
                                                   d:Text="Folder size"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding EstimatedFolderSize}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static strings:Msixvc2Upload.FamilyTitleText}"
                                                   d:Text="Family"
                                                   Style="{DynamicResource WorkflowMetadataLabelStyle}" />
                                        <TextBlock Text="{Binding PackageType}"
                                                   Style="{DynamicResource WorkflowMetadataValueStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Workflow steps -->
                    <StackPanel>
                        <!-- Step 1 -->
                        <Border Style="{DynamicResource WorkflowStepCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{DynamicResource WorkflowStepConnectorStyle}" />
                                <Border Grid.Column="0"
                                        Style="{DynamicResource WorkflowStepIndicatorStyle}">
                                    <TextBlock Text="1"
                                               Style="{DynamicResource WorkflowStepNumberStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static strings:Msixvc2Upload.BuildLocationTitle}"
                                               d:Text="Build location"
                                               Style="{DynamicResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="{x:Static strings:Msixvc2Upload.BuildLocationText}"
                                               d:Text="Locate your loose file directory containing a MicrosoftGame.config. Add a layout file under Additional Details."
                                               Style="{DynamicResource WorkflowStepDescriptionStyle}"
                                               Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Static strings:Msixvc2Upload.ContentPathTitleText}"
                                                   d:Text="Content path"
                                                   Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static strings:Msixvc2Upload.RequiredText}"
                                                   d:Text="Required"
                                                   Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="ContentPathTextBox"
                                                     AutomationProperties.HelpText="Path to content directory"
                                                     Text="{Binding ContentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="{x:Static strings:Msixvc2Upload.ContentPathBoxDefaultText}"
                                                     Style="{DynamicResource WorkflowPathTextBoxStyle}" />
                                            <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding ContentPathError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Content="{x:Static strings:Msixvc2Upload.BrowseText}"
                                                d:Content="Browse"
                                                Command="{Binding BrowseContentPathCommand}"
                                                Style="{DynamicResource WorkflowBrowseButtonStyle}"
                                                AutomationProperties.HelpText="{x:Static strings:Msixvc2Upload.BrowseContentPathHelpText}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding ContentPathError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ContentPathError}"
                                                   Style="{DynamicResource WorkflowValidationTextStyle}" />
                                    </StackPanel>

                                    <Expander Style="{StaticResource CustomExpanderStyle}"
                                              Margin="0,18,0,0"
                                              IsExpanded="{Binding IsAdditionalDetailsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <TextBlock Text="{x:Static strings:Msixvc2Upload.AdditionalDetailsTitle}"
                                                       d:Text="Additional details"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="{DynamicResource SemiboldFontWeight}" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static strings:Msixvc2Upload.LayoutFileMapTitle}"
                                                           d:Text="Layout file/content map"
                                                           Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Static strings:Msixvc2Upload.OptionalText}"
                                                           d:Text="Optional"
                                                           Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         x:Name="MappingDataTextBox"
                                                         AutomationProperties.HelpText="Path to layout file"
                                                         Text="{Binding MappingDataXmlPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="{x:Static strings:Msixvc2Upload.ContentMapPathBoxDefaultText}"
                                                         Style="{DynamicResource WorkflowPathTextBoxStyle}" />
                                                <Button Grid.Column="1"
                                                        Content="{x:Static strings:Msixvc2Upload.BrowseText}"
                                                        d:Content="Browse"
                                                        Command="{Binding BrowseMappingDataXmlPathCommand}"
                                                        Style="{DynamicResource WorkflowBrowseButtonStyle}"
                                                        AutomationProperties.HelpText="Browse to layout file" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border Style="{DynamicResource WorkflowStepCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{DynamicResource WorkflowStepIndicatorStyle}">
                                    <TextBlock Text="2"
                                               Style="{DynamicResource WorkflowStepNumberStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static strings:Msixvc2Upload.DestinationTitleText}"
                                               d:Text="Destination"
                                               Style="{DynamicResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="{x:Static strings:Msixvc2Upload.DestinationSubtitleText}"
                                               d:Text="Select a destination and market for the package upload."
                                               Style="{DynamicResource WorkflowStepDescriptionStyle}"
                                               Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Static strings:Msixvc2Upload.DestinationTitleText}"
                                                   d:Text="Destination"
                                                   Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static strings:Msixvc2Upload.RequiredText}"
                                                   d:Text="Required"
                                                   Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <ComboBox x:Name="flightName"
                                                      ItemsSource="{Binding BranchAndFlightNames, Mode=OneWay}"
                                                      SelectedItem="{Binding BranchOrFlightDisplayName, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLoadingBranchesAndFlights, Converter={StaticResource InverseBooleanConverter}}"
                                                      Style="{StaticResource CustomComboBoxStyle}"
                                                      AutomationProperties.Name="Destination"
                                                      AutomationProperties.HelpText="Choose branch or flight"
                                                      IsTabStop="True"
                                                      TabIndex="1" />
                                            <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding BranchOrFlightErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                        </Grid>
                                        <Image Grid.Column="1"
                                               Source="/Resources/AppIcon/Settings.png"
                                               Width="16"
                                               Height="16"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding IsLoadingBranchesAndFlights, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image.RenderTransform>
                                                <RotateTransform CenterX="8" CenterY="8" />
                                            </Image.RenderTransform>
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Image.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,14"
                                                Visibility="{Binding BranchOrFlightErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding BranchOrFlightErrorMessage}"
                                                   Style="{DynamicResource WorkflowValidationTextStyle}" />
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Static strings:Msixvc2Upload.MarketTitleText}"
                                                   d:Text="Market"
                                                   Style="{DynamicResource WorkflowFieldLabelStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static strings:Msixvc2Upload.RequiredText}"
                                                   d:Text="Required"
                                                   Style="{DynamicResource WorkflowRequirementTextStyle}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <ComboBox x:Name="marketName"
                                                      ItemsSource="{Binding MarketGroupNames, Mode=OneWay}"
                                                      SelectedItem="{Binding MarketGroupName, Mode=TwoWay}"
                                                      Style="{StaticResource CustomComboBoxStyle}"
                                                      AutomationProperties.Name="Market"
                                                      AutomationProperties.HelpText="Choose market"
                                                      IsTabStop="True"
                                                      TabIndex="2">
                                                <ComboBox.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                                                        <Binding Path="IsLoadingMarkets" Converter="{StaticResource InverseBooleanConverter}" />
                                                        <Binding Path="IsLoadingBranchesAndFlights" Converter="{StaticResource InverseBooleanConverter}" />
                                                    </MultiBinding>
                                                </ComboBox.IsEnabled>
                                            </ComboBox>
                                            <Border BorderBrush="{DynamicResource ErrorRedBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding MarketGroupErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                        </Grid>
                                        <Image Grid.Column="1"
                                               Source="/Resources/AppIcon/Settings.png"
                                               Width="16"
                                               Height="16"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding IsLoadingMarkets, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image.RenderTransform>
                                                <RotateTransform CenterX="8" CenterY="8" />
                                            </Image.RenderTransform>
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Image.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource RotateAnimation}" />
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding MarketGroupErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <Image Source="/Resources/AppIcon/ErrorIcon.png"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding MarketGroupErrorMessage}"
                                                   Style="{DynamicResource WorkflowValidationTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Actions -->
                <Border Style="{DynamicResource WorkflowActionBarStyle}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{x:Static strings:Msixvc2Upload.CancelContentText}"
                                d:Content="Cancel"
                                Command="{Binding CancelButtonCommand}"
                                MinWidth="90"
                                Margin="0,0,10,0"
                                AutomationProperties.Name="Cancel Button"
                                AutomationProperties.HelpText="{x:Static strings:Msixvc2Upload.CancelButtonHelpText}"
                                TabIndex="3" />
                        <Button Content="{x:Static strings:Msixvc2Upload.UploadButtonContentText}"
                                d:Content="Upload Package"
                                Command="{Binding UploadPackageCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="133"
                                AutomationProperties.Name="Upload Package Button"
                                AutomationProperties.HelpText="{x:Static strings:Msixvc2Upload.UploadButtonHelpText}"
                                TabIndex="4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
